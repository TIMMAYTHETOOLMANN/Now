# LM Studio Server Configuration
# Copy this file to .env and update the values as needed.

# Base URL for the LM Studio server (OpenAI-compatible API)
LM_STUDIO_BASE_URL=http://10.0.0.182:1270/v1

# API key (LM Studio does not require a real key; use any non-empty string)
LM_STUDIO_API_KEY=lm-studio

# Default model identifier loaded in LM Studio
# Run the /v1/models endpoint to see available models, or check LM Studio UI.
LM_STUDIO_MODEL=default

# Request timeout in seconds
LM_STUDIO_REQUEST_TIMEOUT=120

# Maximum tokens for completions
LM_STUDIO_MAX_TOKENS=2048

# Temperature for generation (0.0 - 2.0)
LM_STUDIO_TEMPERATURE=0.7
